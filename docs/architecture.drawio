        <mxCell id="title" value="&lt;b&gt;Property Compare&lt;/b&gt; — capture, store, compare. Two write paths, one shared data layer." style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="0" width="1140" height="30" as="geometry" />
        </mxCell>

        <mxCell id="N1" value="&lt;b&gt;Chrome extension (MV3)&lt;/b&gt;&lt;br&gt;injected → content → background&lt;br&gt;&lt;i&gt;primary capture path&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="N2" value="&lt;b&gt;Playwright CLI&lt;/b&gt;&lt;br&gt;npm run scrape&lt;br&gt;&lt;i&gt;one-off URL scrapes&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="N3" value="&lt;b&gt;Dev-box CLI scripts&lt;/b&gt;&lt;br&gt;scripts/ — batch-push · load · tag · hero&lt;br&gt;&lt;i&gt;never writes the local DB — pushes over HTTP&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="40" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="N4" value="&lt;b&gt;Browser / installed PWA&lt;/b&gt;&lt;br&gt;public/sw.js caches shell + images&lt;br&gt;&lt;i&gt;works offline at inspections&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="40" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="N5" value="&lt;b&gt;POST /api/ingest&lt;/b&gt;&lt;br&gt;accepts the page's embedded data&lt;br&gt;&lt;i&gt;no auth — LAN only&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="N6" value="&lt;b&gt;POST /api/batch&lt;/b&gt;&lt;br&gt;properties · images · tags · groups · sold · price · shortlist&lt;br&gt;&lt;i&gt;how this box updates the live host&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="160" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="N7" value="&lt;b&gt;Server pages (RSC)&lt;/b&gt;&lt;br&gt;src/app/**/page.tsx&lt;br&gt;&lt;i&gt;rendered per request&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="160" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="N8" value="&lt;b&gt;src/scrape&lt;/b&gt;&amp;nbsp;&amp;nbsp;adapters: pickAdapter → domain.ts · rea.ts&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;extract · persist · images&lt;br&gt;&lt;i&gt;degrades gracefully — stores raw_json and scrape_status rather than throwing&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="840" height="80" as="geometry" />
        </mxCell>
        <mxCell id="N9" value="&lt;b&gt;Client components&lt;/b&gt;&lt;br&gt;src/components + lib/outbox&lt;br&gt;&lt;i&gt;IndexedDB queue, replays when online&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="280" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="N10" value="&lt;b&gt;Mutation API routes&lt;/b&gt;&lt;br&gt;properties/[id]/{notes,rating,metadata,media}&lt;br&gt;images/[id]/tag · config · shares&lt;br&gt;&lt;i&gt;notes · rating write via db/client&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="410" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="N11" value="&lt;b&gt;src/db/queries&lt;/b&gt;&amp;nbsp;&amp;nbsp;properties · load · status · tags · rooms · metadata · shares · settings · jobs · changes · shortlist&lt;br&gt;&lt;i&gt;one write surface — the batch endpoint and the CLI helpers call the same functions, so they cannot drift&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="530" width="640" height="70" as="geometry" />
