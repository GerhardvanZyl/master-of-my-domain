# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# runtime data (SQLite DB + downloaded images) — never commit
# /data/

# env
.env
.env.local

# misc
*.log
.DS_Store

# UI test build output
.next-test/

# local TLS certs / private keys — never commit
certs/
public/rootCA.crt

# SQLite WAL sidecar files (transient — never commit)
data/app.db-shm
data/app.db-wal

# local-model benchmark output (regenerable, grows on every run)
data/_tagbench.jsonl

# per-run scratch from the update-properties round (snapshot, diff, per-chunk
# listing-pass payloads, generated browser snippets). Regenerated every run and
# only useful for resuming one — the durable harvest files next to them
# (feed.json, stations.json, metadata.json) stay tracked.
data/harvest/_*
data/harvest/pass-*.json
data/harvest/diag.json
data/harvest/drop.json

# pre-migration DB snapshots
data/app.db.backup-*

# inspection photos/videos straight off the phone — GitHub rejects >100 MB files
data/media/

# subagent-driven-development scratch (ledger, briefs, review packages)
/.superpowers/

# Image cache pulled from the live app by scripts/_tag-remote.ts (regenerable)
.remote-imgs/

# dev-loop review run artifacts (findings, logs, scratch worktrees)
.claude/review/runs/
